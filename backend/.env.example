# ---------------------------------------------------------------------------
# Optional AI provider (OpenAI-compatible)
# ---------------------------------------------------------------------------
# The app works without these values: the AI assistant and recommendations
# automatically fall back to deterministic rules built from the real events.
#
# Copy this file to .env and fill in AI_API_KEY to enable the provider.
# Never commit .env — it is ignored by Git.

# Required for hosted providers.
# Local providers (localhost / 127.0.0.1) work with an empty key.
AI_API_KEY=

# OpenAI-compatible base URL.
#   OpenAI:  https://api.openai.com/v1
#   Ollama:  http://localhost:11434/v1   (local, no key needed)
AI_BASE_URL=https://api.openai.com/v1

# Chat model name, for example: gpt-4o-mini, llama3.1, mistral
AI_MODEL=gpt-4o-mini

# Request timeout in seconds (5–60).
AI_TIMEOUT=20
